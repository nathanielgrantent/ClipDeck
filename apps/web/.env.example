# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://gaming:gaming@localhost:5432/gaming_clips?schema=public"

# ---------------------------------------------------------------------------
# Redis (BullMQ job queue + presence pub/sub)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Discord OAuth
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Steam (Steamworks OAuth, optional)
AUTH_STEAM_API_KEY=""
STEAM_API_KEY=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="ClipDeck"

# Uploads storage (persistent volume in production)
UPLOAD_DIR="/data/uploads"

# ---------------------------------------------------------------------------
# Game data
# ---------------------------------------------------------------------------
# Optional RAWG sync token (leave blank to use bundled dataset only)
RAWG_API_KEY=""

# ffmpeg binary path (auto-detected from PATH when empty)
FFMPEG_PATH=""
FFPROBE_PATH=""
