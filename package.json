{
  "name": "gaming-clips",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source gaming clip platform - Discord-style Reddit UI with Pinterest gallery, automod, and a Tauri desktop app.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gamingclips/web",
    "build": "npm run build -w @gamingclips/web",
    "start": "npm run start -w @gamingclips/web",
    "lint": "npm run lint -w @gamingclips/web",
    "typecheck": "npm run typecheck -w @gamingclips/web && npm run typecheck -w @gamingclips/shared",
    "worker": "npm run worker -w @gamingclips/web",
    "prisma:generate": "npm run prisma:generate -w @gamingclips/web",
    "prisma:migrate": "npm run prisma:migrate -w @gamingclips/web",
    "prisma:push": "npm run prisma:push -w @gamingclips/web",
    "db:seed": "npm run db:seed -w @gamingclips/web",
    "desktop:dev": "npm run tauri dev -w @gamingclips/desktop",
    "desktop:build": "npm run tauri build -w @gamingclips/desktop",
    "test": "npm run test -w @gamingclips/web"
  }
}
